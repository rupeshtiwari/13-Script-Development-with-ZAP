# Demo environment configuration for M1 Clip 3
# APP_BUILD selects the code path baked into the app: vulnerable | remediated
APP_BUILD=vulnerable

# ZAP API key — used only by author tooling (preflight). Not a secret in this training context.
ZAP_API_KEY=m1clip3zapkey

# Pinned ZAP image (ZAP 2.17.0)
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable@sha256:781a2bdaea47324e7bab583e2263f21d257b0aee61ed51521a5be45f5f5081ef

# Postgres
POSTGRES_USER=globo
POSTGRES_PASSWORD=globo
POSTGRES_DB=globomantics

# Mongo
MONGO_INITDB_DATABASE=globomantics
